# --- Database (Neon pooled connection string) ---
DATABASE_URL=

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# The app's public address, e.g. https://blomp.vercel.app
AUTH_URL=
# GitHub OAuth App: callback https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Kane runner (GitHub Actions) ---
# Fine-grained token: Actions read+write on the blomp repo only
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=your-username/blomp
# Branch that holds kane-scan.yml (default main)
GITHUB_WORKFLOW_REF=main
# Public address the runner posts results to (default: AUTH_URL)
INGEST_BASE_URL=
# Shared secret the runner uses to sign posts to /api/ingest (openssl rand -hex 32)
INGEST_SECRET=
# Shared secret for GitHub webhooks (openssl rand -hex 32)
WEBHOOK_SECRET=

# --- AI (NVIDIA NIM, OpenAI-compatible) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Evidence screenshots (added automatically when you connect a Vercel Blob store) ---
BLOB_READ_WRITE_TOKEN=
